# Environment variables for backend
# Copy this to .env and fill in your values

# Database Configuration
# Choose database type: 'mongodb' | 'file' | 'memory'
# Default is 'file' for local development.
# For Render production with auth enabled, use 'mongodb'.
DB_TYPE=file

# MongoDB Connection (only needed if DB_TYPE=mongodb)
# For local MongoDB: mongodb://localhost:27017/gold-provenance
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/gold-provenance
# MONGODB_URI=mongodb://localhost:27017/gold-provenance

# Blockchain Configuration (EventLogger / Merkle Anchoring)
PRIVATE_KEY=0x_your_private_key_here
CONTRACT_ADDRESS=0xEAFdbD04C0Cecf8310ae68A26b479fE4d286db19
POLYGON_RPC=https://rpc-amoy.polygon.technology

# ============ TRACEABILITY CONTRACT ============
# GoldSilverTraceability.sol on Polygon zkEVM Cardona Testnet
# Deploy: npx hardhat run scripts/deploy-traceability.cjs --network zkevm-testnet
TRACEABILITY_CONTRACT_ADDRESS=
TRACEABILITY_RPC_URL=https://rpc.cardona.zkevm-rpc.com
TRACEABILITY_EXPLORER=https://cardona-zkevm.polygonscan.com
# Max blocks per eth_getLogs call. Public Polygon/zkEVM RPCs cap at ~2 000.
# Lower this (e.g. 500) if you still see "block range exceed" errors.
TRACEABILITY_CHUNK_SIZE=2000
# Block number where the traceability contract was deployed (skips scanning
# earlier blocks on first start — speeds up initial sync dramatically).
# TRACEABILITY_DEPLOY_BLOCK=

# ============ UNTP (UN Transparency Protocol) ============
# Base URL used to build resolvable entity URIs in UNTP credentials.
# Must be the public URL where this server is reachable.
# e.g.  https://goldprovenance.yourdomain.com/
# If not set, credentials use urn:goldprov: URNs (still schema-valid).
UNTP_BASE_URI=http://localhost:3000/

# Server did:web identity. Must match the domain where /.well-known/did.json
# is served. For local dev "did:web:localhost" is fine.
# Production example: did:web:gold-provenance-api.onrender.com
UNTP_DID=did:web:localhost

# Human-readable name shown in the "issuer.name" field of every VC.
UNTP_ISSUER_NAME=Gold Provenance System

# Optional public human-readable credential viewer base (used for VC renderMethod).
# Example: https://gold-provenance-ui.onrender.com
UNTP_RENDER_BASE_URI=

# Optional override for the Ed25519 VC signing key.
# If omitted, the app generates one once and stores it in DATA_DIR/untp-signing-key.jwk.
# UNTP_SIGNING_PRIVATE_JWK={"crv":"Ed25519","d":"...","x":"...","kty":"OKP"}
# UNTP_SIGNING_PRIVATE_PEM=-----BEGIN PRIVATE KEY-----...
# UNTP_SIGNING_KEY_PATH=./data/untp-signing-key.jwk

# Optional validity period for issued credentials and status lists.
# Leave blank for no explicit validUntil.
# UNTP_CREDENTIAL_VALID_DAYS=365

# W3C Bitstring Status List size in bits. UNTP/W3C require at least 131072.
UNTP_STATUS_LIST_BITS=131072

# Server Configuration
PORT=3000
NODE_ENV=development

# Data persistence directory (for file-based DB)
DATA_DIR=./data

# ============ AUTH & SECURITY ============
AUTH_ENABLED=true
RBAC_ENABLED=true
JWT_SECRET=your-jwt-secret-at-least-32-chars-long
JWT_REFRESH_SECRET=your-refresh-secret-at-least-32-chars-long
JWT_ISSUER=gold-provenance
JWT_AUDIENCE=gold-provenance-api
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY_DAYS=30
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCK_DURATION_MINUTES=15
DEFAULT_USER_ROLE=VIEWER

# ============ BOOTSTRAP SUPERADMIN ============
# Set BOOTSTRAP_ENABLE=true on FIRST RUN only to create the initial superadmin.
# Disable after creation for security. On Render, set this back to false after
# the first successful deploy/login.
BOOTSTRAP_ENABLE=true
BOOTSTRAP_SUPERADMIN_EMAIL=admin@goldprovenance.io
BOOTSTRAP_SUPERADMIN_PASSWORD=ChangeMe!Str0ng#Pass2026

# ============ SECURITY HARDENING ============
# For Render/static frontend deployments, set this to the exact frontend origin
# (for example https://gold-provenance-ui.onrender.com), not '*'.
CORS_ORIGIN=*
RATE_LIMIT_MAX=500
