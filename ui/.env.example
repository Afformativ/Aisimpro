# Environment variables for local development
# Copy this to .env.local and fill in your values

# API URL (for production/Render, this should point to your deployed backend)
# Example: https://gold-provenance-api.onrender.com/api
VITE_API_URL=http://localhost:3000/api

# Base path for GitHub Pages deployment (set during CI/CD)
# VITE_BASE_PATH=/gold-provenance/
